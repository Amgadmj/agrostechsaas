# AgrosTech Beta SaaS: environment template
# Copy to .env.local (gitignored) and fill in. Never commit real values.
# Full reference: docs/04-operations/ENVIRONMENT.md
#
# Status legend:
#   [READ]     the code reads this variable today
#   [RESERVED] documented for the planned integration; no code reads it yet

# -----------------------------------------------------------------------------
# Runtime mode
# -----------------------------------------------------------------------------
# [READ] "true" enables the demo login (portal cookie, no password) and the
# "Dados de Demonstração" badge. Must be "false" in any environment real clients use.
NEXT_PUBLIC_DEMO_MODE=true

# [READ] "demo" lets the Registro Rural client serve offline SICAR fixtures.
# "production" makes a missing/invalid API key a hard error (CONFIG_MISSING_API_KEY).
INTEGRITY_MODE=demo

# [READ] "true" also allows fixture fallback when the live gateway is unreachable.
ALLOW_MOCK_FALLBACK=true

# -----------------------------------------------------------------------------
# Supabase (Postgres + PostGIS + Auth)
# -----------------------------------------------------------------------------
# [READ] Schema: supabase/schema.sql. Seed: supabase/seed.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# [RESERVED] Server-only admin key. Not read by the app today; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Registro Rural gateway (SICAR demonstrativo + R2C compliance)
# -----------------------------------------------------------------------------
# [READ] API key from https://registrorural.com.br
REGISTRO_RURAL_API_KEY=
# [READ] Optional override. Default: https://api-gateway-v2.registrorural.com.br
REGISTRO_RURAL_BASE_URL=https://api-gateway-v2.registrorural.com.br

# -----------------------------------------------------------------------------
# 2D basemap
# -----------------------------------------------------------------------------
# [RESERVED] Basemap tile sources are hardcoded in MapView2D.tsx / MiniMap.tsx
# (Esri World Imagery, Carto dark). Kept because tests/e2e F15-01 checks for it.
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# -----------------------------------------------------------------------------
# 3D digital twin (CesiumJS)
# -----------------------------------------------------------------------------
# [READ] Cesium ion token for World Terrain. Without it the viewer falls back to
# the ellipsoid (flat) terrain. https://ion.cesium.com/tokens
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# -----------------------------------------------------------------------------
# SAR satellite data
# -----------------------------------------------------------------------------
# [RESERVED] The BDC STAC endpoint is hardcoded in src/lib/sar/bdcStacClient.ts
# (https://data.inpe.br/bdc/stac/v1); these are for when it becomes configurable.
BDC_STAC_URL=https://data.inpe.br/bdc/stac/v1
BDC_ACCESS_TOKEN=
# [RESERVED] Commercial tasking adapters only build and validate orders today;
# they do not call the provider APIs yet.
UMBRA_API_KEY=
TERRASARX_API_KEY=
